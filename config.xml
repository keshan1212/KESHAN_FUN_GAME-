
<?xml version="1.0" encoding="UTF-8"?>

<widget
    id="com.keshan.fungame"
    version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>KESHAN FUN GAME</name>

    <description>
        Play 100 exciting arrow puzzle levels.
    </description>

    <author email="support@example.com">
        KESHAN FUN GAME
    </author>

    <content src="index.html" />

    <access origin="*" />

    <preference
        name="Orientation"
        value="portrait" />

    <preference
        name="Fullscreen"
        value="true" />

    <preference
        name="DisallowOverscroll"
        value="true" />

    <preference
        name="AndroidXEnabled"
        value="true" />

</widget>
